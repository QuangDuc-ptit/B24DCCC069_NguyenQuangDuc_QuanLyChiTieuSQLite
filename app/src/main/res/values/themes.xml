<resources>
    <!-- Theme chính phong cách Productive Mockup -->
    <style name="Theme.ExpenseManager" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/petrol_dark</item>
        <item name="colorPrimaryDark">@color/petrol_darker</item>
        <item name="colorAccent">@color/amber_orange</item>

        <!-- Nền & Chữ mặc định -->
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Font Poppins với fallback sans-serif -->
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>

        <!-- Bo góc mặc định cho dialog -->
        <item name="alertDialogTheme">@style/CustomAlertDialogTheme</item>
    </style>

    <!-- Custom AlertDialog bo góc 24dp chuẩn mockup -->
    <style name="CustomAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorAccent">@color/amber_orange</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogNegativeButton</item>
    </style>

    <style name="DialogPositiveButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/amber_orange</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DialogNegativeButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
