<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Vòng tròn mờ bên ngoài -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#4DF5A94A" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Vòng tròn chính màu cam hổ phách bên trong -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/amber_orange" />
        </shape>
    </item>
</layer-list>

