<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardStatContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium"
    android:background="@drawable/bg_card_peach"
    android:elevation="@dimen/elevation_soft"
    android:orientation="vertical"
    android:padding="@dimen/card_inner_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Ô icon danh mục -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_input_rounded"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivStatIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/label_category"
                android:src="@drawable/ic_cat_food" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvStatCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_card_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/petrol_dark"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ProgressBar ngang bo tròn cao 8dp, track kem đậm, indicator cam -->
    <ProgressBar
        android:id="@+id/pbStatCategory"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="@dimen/spacing_medium"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_progress_bar_horizontal" />

</LinearLayout>
